# Copy to .env and change every credential before using this for anything
# persistent or shared. No real secret belongs in a committed file.

GROWNERVE_DATABASE_URL=postgresql://grownerve_app:app_password@127.0.0.1:5432/grownerve?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/grownerve?sslmode=disable

APP_ENV=development
APP_SERVER__ADDRESS=127.0.0.1:8080
APP_MQTT__BROKER=tcp://127.0.0.1:1883

# Authentication. Development defaults to mode "dev", which grants an
# administrator principal with no credential; a production process refuses to
# start in that mode.
APP_AUTH__MODE=dev

# Local mode accounts, as "subject:role:sha256-of-token" entries separated by
# commas. Only the digest is stored, so this file never holds a usable token.
# Generate one with:  printf '%s' "$TOKEN" | shasum -a 256
# Roles: viewer, operator, manager, administrator.
GROWNERVE_LOCAL_ACCOUNTS=

# OIDC mode.
APP_AUTH__OIDC__ISSUER=
APP_AUTH__OIDC__AUDIENCE=

# Broker credentials. Required in production; a production process refuses to
# start without them, because an anonymous broker lets anything publish
# telemetry the server would treat as real.
GROWNERVE_MQTT_USERNAME=
GROWNERVE_MQTT_PASSWORD=

# Measurement retention. Empty or 0 keeps everything.
APP_TELEMETRY__RETENTION=

GROWNERVE_POSTGRES_PORT=5432
GROWNERVE_MQTT_PORT=1883
GROWNERVE_API_PORT=8080
